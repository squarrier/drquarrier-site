---
// Teaching/fellowship inquiry form. Submits to Web3Forms via AJAX (no page reload).
// No PHI is collected — this is for professional inquiries only (referrals go to /for-providers).
// The recipient email lives in the Web3Forms access key (server-side); it is never exposed here.
const ACCESS_KEY = 'b97915c7-59be-4b0d-815e-b15d82eaf885';
---
<section id="cf" aria-labelledby="cf-h">
  <h2 id="cf-h">Send a training or fellowship inquiry</h2>
  <p class="cf-lede">For residents interested in the fellowship, practicing urologists who want to observe or train, and course organizers. <strong>Please don't include patient information here</strong> — to send a patient, use <a href="/for-providers/">Refer a patient</a> instead.</p>

  <form id="cf-form" novalidate>
    <input type="hidden" name="access_key" value={ACCESS_KEY} />
    <input type="hidden" name="subject" value="drquarrier.com - Teaching inquiry" />
    <input type="hidden" name="from_name" value="drquarrier.com Teaching form" />
    <input type="checkbox" name="botcheck" class="cf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="cf-grid">
      <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
      <label>Email<input type="email" name="email" required autocomplete="email" /></label>
    </div>
    <label>I'm a&hellip;
      <select name="role" required>
        <option value="">Select one</option>
        <option>Resident interested in the fellowship</option>
        <option>Practicing urologist — training / observership</option>
        <option>Course organizer</option>
        <option>Other</option>
      </select>
    </label>
    <label>Message<textarea name="message" rows="5" required></textarea></label>
    <button type="submit" id="cf-submit">Send inquiry</button>
    <p class="cf-status" id="cf-status" role="status" aria-live="polite"></p>
  </form>
</section>

<style is:global>
  #cf { margin: 2rem 0 0; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  #cf .cf-lede { color: var(--muted); font-size: .95rem; }
  #cf form { max-width: 640px; }
  #cf label { display: block; font-weight: 500; color: var(--ink); font-size: .92rem; margin: 0 0 .9rem; }
  #cf input[type="text"], #cf input[type="email"], #cf select, #cf textarea {
    display: block; width: 100%; margin-top: .3rem; padding: .6rem .7rem; font: inherit;
    border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--body); }
  #cf input:focus, #cf select:focus, #cf textarea:focus { outline: 3px solid var(--focus); outline-offset: 1px; border-color: var(--accent); }
  #cf .cf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  #cf .cf-hp { position: absolute; left: -9999px; opacity: 0; }
  #cf button { font: inherit; font-weight: 600; background: var(--navy); color: #fff; border: 0; border-radius: 8px; padding: .7rem 1.4rem; cursor: pointer; }
  #cf button:hover { background: var(--accent-600); }
  #cf button:disabled { opacity: .6; cursor: default; }
  #cf .cf-status { margin: .8rem 0 0; font-weight: 500; min-height: 1.2em; }
  #cf .cf-status.ok { color: var(--good); }
  #cf .cf-status.err { color: #b03a2e; }
  @media (max-width: 540px) { #cf .cf-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('cf-form');
    if (!form) return;
    var status = document.getElementById('cf-status');
    var btn = document.getElementById('cf-submit');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      btn.disabled = true; status.className = 'cf-status'; status.textContent = 'Sending...';
      fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            form.reset();
            status.className = 'cf-status ok';
            status.textContent = 'Thank you - your message was sent. The office will be in touch.';
          } else {
            status.className = 'cf-status err';
            status.textContent = 'Something went wrong. Please email or call (585) 275-2838.';
          }
        })
        .catch(function () {
          status.className = 'cf-status err';
          status.textContent = 'Something went wrong. Please call (585) 275-2838.';
        })
        .finally(function () { btn.disabled = false; });
    });
  })();
</script>
