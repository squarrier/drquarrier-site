---
import { getCollection, render } from 'astro:content';
import { SITE } from '../consts';
import Base from '../layouts/Base.astro';
import CallCTA from '../components/CallCTA.astro';
import FaqSchema from '../components/FaqSchema.astro';
import ContactForm from '../components/ContactForm.astro';

// Raw markdown for every content page (used to build FAQPage JSON-LD from the FAQ body).
const rawPages = import.meta.glob('../content/pages/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, SITE.domain).href;
const isFaq = page.data.schemaType === 'FAQPage';
const rawBody = isFaq ? (rawPages[`../content/pages/${page.id}.md`] ?? '') : '';
---
<Base title={page.data.title} description={page.data.description} schemaType={page.data.schemaType}>
  {isFaq && <FaqSchema body={rawBody} pageUrl={canonical} />}
  <div class="page">
    <article class="container prose">
      <Content />
      {page.id === 'fellowship' && <ContactForm />}
    </article>
  </div>
  <CallCTA sub="Calling does not commit you to surgery — it starts the conversation." />
</Base>
